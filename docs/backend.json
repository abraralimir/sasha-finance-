{
  "entities": {
    "LoanApplication": {
      "title": "LoanApplication",
      "type": "object",
      "description": "Represents a single loan application submitted by a user.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the application." },
        "fullName": { "type": "string", "description": "The user's full name." },
        "loanAmount": { "type": "number", "description": "The current loan amount requested by the user." },
        "loanStatus": { "type": "string", "description": "The status of the loan (approved, rejected)." },
        "loanReason": { "type": "string", "description": "The AI rationale for the loan status." },
        "creditScore": { "type": "number", "description": "The user's credit score." },
        "annualIncome": { "type": "number", "description": "The user's annual income." },
        "employmentStatus": { "type": "string", "description": "The user's employment status." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of when the application was created."}
      },
      "required": ["id", "fullName", "loanAmount", "loanStatus", "creditScore", "annualIncome", "employmentStatus", "createdAt"]
    }
  },
  "auth": {
    "providers": []
  },
  "firestore": {
    "structure": [
      {
        "path": "/loanApplications/{applicationId}",
        "definition": {
          "entityName": "LoanApplication",
          "schema": {
            "$ref": "#/backend/entities/LoanApplication"
          },
          "description": "Stores individual loan applications.",
          "params": [
            {
              "name": "applicationId",
              "description": "The unique ID of the loan application."
            }
          ]
        }
      }
    ]
  }
}
